# Secrets never enter the build context (R-02), at any depth
**/.env
**/.env.*
!.env.example
**/*.pem
**/*.key
**/*.p12
**/.npmrc
**/gha-creds-*.json

# Installed and built inside the image
node_modules
**/node_modules
**/dist
**/*.tsbuildinfo
web/.vite

# Not needed to build or run the app
.git
.github
.vscode
.idea
docs
tests
coverage
test-results
playwright-report
blob-report
**/*.log
Dockerfile
.dockerignore
docker-compose.yml
