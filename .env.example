# Environment mode (development, test, production)
NODE_ENV=development

# HTTP server port
PORT=8080

# PostgreSQL credentials and port (used by docker-compose and Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pangtao_db
POSTGRES_PORT=5432

# PostgreSQL database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pangtao_db

# Optional: database for automated tests (wiped on every run; name must end in _test).
# Defaults to DATABASE_URL's database + "_test" (pangtao_db_test), created automatically.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pangtao_db_test

# Session lifetime in hours
SESSION_TTL_HOURS=8

# Secure cookie flag (false for local development, true in production)
COOKIE_SECURE=false

# Bcrypt hash rounds (>= 12 for NFR-01)
BCRYPT_COST=12

# Application timezone (for transaction date boundaries per BR-10)
APP_TIMEZONE=Asia/Bangkok

# Password for the synthetic seed accounts (admin, alice, bob). REQUIRED:
# choose your own value locally; seed, tests and E2E refuse to run without it.
# Never commit a real value (NFR-01 / AC-01.10).
SEED_DEFAULT_PASSWORD=

# Application logging verbosity (debug, info, warn, error)
LOG_LEVEL=info
