datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  displayName     String           @map("display_name")
  passwordHash    String           @map("password_hash")
  role            Role             @default(USER)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  sessions        Session[]
  accounts        Account[]
  transactions    Transaction[]
  allocationLines AllocationLine[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Ledger (F-03; system-sds §2). Money is integer satang in BIGINT columns.
// Balances are derived, never stored (BR-07): there is no balance column.
//
// The migration also adds raw-SQL objects Prisma cannot express:
//   accounts_subtype_valid, transactions_total_amount_range,
//   allocation_lines_amount_range (CHECK constraints) and the partial unique
//   index unique_active_opening_balance. If a later `migrate dev`
//   generates a DROP for any of them, delete that statement before applying.
// ---------------------------------------------------------------------------

enum AccountType {
  CASH
  LOAN_TAKEN
  LOAN_GIVEN
  INCOME
  EXPENSE
}

enum AccountSubtype {
  WALLET
  BANK
  CREDIT_CARD
  OTHER
}

enum TransactionKind {
  PAYMENT
  RECEIPT
  OPENING_BALANCE
}

model Account {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       AccountType
  subtype    AccountSubtype?
  isArchived Boolean         @default(false) @map("is_archived")
  createdAt  DateTime        @default(now()) @map("created_at")

  sourceTransactions Transaction[]
  allocationLines    AllocationLine[]

  @@unique([userId, name])
  // Target of the composite foreign keys that keep every ledger row inside one user.
  @@unique([userId, id])
  @@map("accounts")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        TransactionKind
  accountId   String          @map("account_id") @db.Uuid
  // Composite FK: the source account must belong to the same user.
  account     Account         @relation(fields: [userId, accountId], references: [userId, id], onDelete: NoAction)
  txnDate     DateTime        @map("txn_date") @db.Date
  totalAmount BigInt          @map("total_amount")
  memo        String?
  isFavorite  Boolean         @default(false) @map("is_favorite")
  voidedAt    DateTime?       @map("voided_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  lines AllocationLine[]

  @@unique([userId, id])
  @@index([userId, txnDate(sort: Desc), createdAt(sort: Desc)])
  @@index([accountId])
  @@map("transactions")
}

model AllocationLine {
  id              String      @id @default(uuid()) @db.Uuid
  transactionId   String      @map("transaction_id") @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite FK: a line belongs to a transaction of the same user; deleted with it.
  transaction     Transaction @relation(fields: [userId, transactionId], references: [userId, id], onDelete: Cascade)
  targetAccountId String      @map("target_account_id") @db.Uuid
  // Composite FK: the target account must belong to the same user.
  targetAccount   Account     @relation(fields: [userId, targetAccountId], references: [userId, id], onDelete: NoAction)
  amount          BigInt
  lineNo          Int         @map("line_no")
  note            String?

  @@unique([transactionId, lineNo])
  @@index([targetAccountId])
  @@map("allocation_lines")
}
